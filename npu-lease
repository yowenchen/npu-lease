#!/usr/bin/python3
"""Coordinate access to Ascend devices via a local Unix socket."""

import argparse
from dataclasses import dataclass
import asyncio
import errno
import fcntl
import grp
import json
import os
import re
import signal
import socket
import stat
import struct
import subprocess
import sys
import tempfile
from pathlib import Path

DEFAULT_SOCKET = "/run/npu-lease/control.sock"
SMI = "/usr/local/sbin/npu-smi"
LIMIT = 4096


def smi(*args):
    env = dict(os.environ, LC_ALL="C")
    return subprocess.run(
        [SMI, "info", *args], env=env, stdin=subprocess.DEVNULL,
        capture_output=True, text=True, timeout=5, check=True,
    ).stdout


def inventory():
    rows = [line.split() for line in smi("-m").splitlines() if line.strip()]
    if not rows or " ".join(rows[0]) != "NPU ID Slot ID Chip ID Chip Phy-ID Chip Name":
        raise ValueError("unrecognized npu-smi device inventory")
    ids = []
    for row in rows[1:]:
        if (len(row) != 5 or not all(field.isdecimal() for field in row[:4])
                or row[2] != "0" or row[0] != row[3]):
            raise ValueError("requires one chip per NPU and matching NPU and physical IDs")
        ids.append(int(row[0]))
    if not ids or len(ids) != len(set(ids)):
        raise ValueError("empty or ambiguous NPU inventory")
    return sorted(ids)


def probe(device):
    try:
        output = smi("-t", "proc-mem", "-i", str(device), "-p", "0")
    except (OSError, subprocess.SubprocessError, UnicodeError):
        return "unknown"
    lines = [line.strip() for line in output.splitlines() if line.strip()]
    if not lines or not re.fullmatch(rf"NPU ID\s*:\s*{device}", lines[0]):
        return "unknown"
    if lines[1:] == ["No process in device."]:
        return "idle"
    if any(
        re.match(r"^Process ID\s*:\s*[1-9][0-9]*\b", line, re.IGNORECASE)
        for line in lines[1:]
    ):
        return "busy"
    return "unknown"


def process_identity(pid):
    try:
        raw = Path(f"/proc/{pid}/stat").read_bytes()
    except FileNotFoundError:
        return None
    fields = raw.rsplit(b") ", 1)[1].split()
    if fields[0] in (b"Z", b"X"):
        return None
    return int(fields[1]), int(fields[19])


class LeaseStore:
    def __init__(self, path):
        self.path = path
        self.boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()

    def load(self, devices):
        if not self.path.exists():
            return {}
        data = json.loads(self.path.read_text())
        if not isinstance(data, dict) or set(data) != {"boot_id", "devices"}:
            raise ValueError("invalid lease state")
        if data["boot_id"] != self.boot_id:
            return {}
        active = {}
        for key, holder in data["devices"].items():
            device = int(key)
            if (device not in devices or device in active or not isinstance(holder, dict)
                    or set(holder) != {"pid", "uid", "start_time"}
                    or any(type(value) is not int or value < 0 for value in holder.values())
                    or holder["pid"] == 0):
                raise ValueError("invalid or incompatible lease state")
            active[device] = holder
        return active

    def save(self, active):
        bound = {device: holder for device, holder in active.items() if "start_time" in holder}
        with tempfile.NamedTemporaryFile(mode="w", dir=self.path.parent, delete=False) as stream:
            pending = Path(stream.name)
            try:
                json.dump({"boot_id": self.boot_id, "devices": bound}, stream)
                stream.flush()
                os.fsync(stream.fileno())
                pending.replace(self.path)
                directory = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(directory)
                finally:
                    os.close(directory)
            finally:
                pending.unlink(missing_ok=True)


@dataclass
class Request:
    candidates: list[int]
    count: int
    wait: bool
    pid: int
    uid: int
    disconnected: asyncio.Task
    result: asyncio.Future


class Leases:
    def __init__(self, devices, store):
        self.devices = devices
        self.store = store
        self.active = store.load(devices)
        self.lock = asyncio.Lock()
        self.clients = 0
        self.pending = {}
        self.changed = asyncio.Event()

    def reap(self):
        expired = []
        for device, holder in self.active.items():
            if "start_time" not in holder:
                continue
            identity = process_identity(holder["pid"])
            if identity is None or identity[1] != holder["start_time"]:
                expired.append(device)
        if expired:
            remaining = {device: holder for device, holder in self.active.items() if device not in expired}
            self.store.save(remaining)
            self.active = remaining

    def bind_workload(self, connect_pid, uid, devices, registration):
        pid = registration.get("pid") if isinstance(registration, dict) else None
        if type(pid) is not int or pid <= 0:
            raise ValueError("expected a workload PID")
        identity = process_identity(pid)
        if identity is None or identity[0] != connect_pid:
            raise ValueError("workload must be a live child of the lease client")
        holder = {"pid": pid, "uid": uid, "start_time": identity[1]}
        updated = dict(self.active)
        updated.update({device: holder for device in devices})
        self.store.save(updated)
        self.active = updated

    async def schedule(self):
        while True:
            if self.pending or self.active:
                try:
                    await asyncio.wait_for(self.changed.wait(), timeout=1)
                except TimeoutError:
                    pass
            else:
                await self.changed.wait()
            self.changed.clear()

            async with self.lock:
                self.reap()
                probes = {}
                for request in list(self.pending.values()):
                    if request.result.done() or request.disconnected.done():
                        continue
                    states = await self.snapshot(request.candidates, request.count, probes)
                    if request.result.done() or request.disconnected.done():
                        continue
                    chosen = [device for device, state in states.items() if state["state"] == "idle"]
                    if len(chosen) == request.count:
                        for device in chosen:
                            self.active[device] = {"uid": request.uid, "pid": request.pid}
                        request.result.set_result({"ids": chosen})
                    elif not request.wait:
                        request.result.set_result({
                            "error": "requested devices unavailable", "devices": states,
                        })

    async def snapshot(self, candidates, count=None, probes=None):
        if probes is None:
            probes = {}
        states = {}
        for device in candidates:
            holder = self.active.get(device)
            if holder is not None:
                states[device] = {"state": "leased", **holder}
            else:
                if device not in probes:
                    probes[device] = await asyncio.to_thread(probe, device)
                states[device] = {"state": probes[device]}
            if count is not None and sum(s["state"] == "idle" for s in states.values()) == count:
                break
        return states

    def validate(self, request):
        explicit = request.get("ids")
        count = request.get("num")
        if explicit is not None:
            if (count is not None or not isinstance(explicit, list) or not explicit
                    or any(type(device) is not int or device not in self.devices for device in explicit)
                    or len(explicit) != len(set(explicit))):
                raise ValueError("ids must be distinct device IDs from the daemon inventory")
            return explicit, len(explicit)
        if type(count) is not int or not 1 <= count <= len(self.devices):
            raise ValueError("num must be between 1 and the inventory size")
        return self.devices, count

    async def handle(self, reader, writer):
        if self.clients >= 128:
            writer.close()
            return
        self.clients += 1
        allocation = None
        disconnected = None
        bound = False
        try:
            raw = await asyncio.wait_for(reader.readline(), timeout=5)
            if not raw:
                return
            request = json.loads(raw)
            if not isinstance(request, dict):
                raise ValueError("expected a request object")
            if request.get("op") == "status":
                async with self.lock:
                    self.reap()
                    states = await self.snapshot(self.devices)
                await reply(writer, {"devices": states})
                return
            if request.get("op") != "run" or type(request.get("wait")) is not bool:
                raise ValueError("invalid request")
            candidates, count = self.validate(request)
            peer = writer.get_extra_info("socket").getsockopt(
                socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"),
            )
            pid, uid, _ = struct.unpack("3i", peer)
            disconnected = asyncio.create_task(reader.readline())
            allocation = asyncio.get_running_loop().create_future()
            self.pending[allocation] = Request(
                candidates, count, request["wait"], pid, uid, disconnected, allocation,
            )
            self.changed.set()
            await asyncio.wait({allocation, disconnected}, return_when=asyncio.FIRST_COMPLETED)
            self.pending.pop(allocation)
            if disconnected.done():
                return
            response = allocation.result()
            await reply(writer, response)
            if "ids" in response:
                raw_registration = await asyncio.wait_for(disconnected, timeout=15)
                if not raw_registration:
                    return
                async with self.lock:
                    self.bind_workload(pid, uid, response["ids"], json.loads(raw_registration))
                    bound = True
                await reply(writer, {"bound": True})
        except (ValueError, TimeoutError) as exc:
            try:
                await reply(writer, {"error": str(exc) or "request timed out"})
            except (ConnectionError, OSError):
                pass
        except (ConnectionError, OSError):
            pass
        finally:
            if disconnected is not None:
                disconnected.cancel()
            if allocation is not None:
                self.pending.pop(allocation, None)
                if allocation.done() and not allocation.cancelled():
                    granted = allocation.result().get("ids", [])
                    if granted and not bound:
                        async with self.lock:
                            for device in granted:
                                del self.active[device]
                allocation.cancel()
                self.changed.set()
            self.clients -= 1
            writer.close()


async def reply(writer, response):
    writer.write(json.dumps(response).encode() + b"\n")
    await writer.drain()


async def daemon(path, group):
    parent = path.parent.stat()
    if parent.st_uid != os.geteuid() or parent.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise ValueError("socket parent must be daemon-owned and writable only by its owner")
    lock_path = path.with_name(path.name + ".lock")
    with open(lock_path, "a", opener=private_file) as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        await serve(path, group)


def private_file(path, flags):
    return os.open(path, flags | os.O_NOFOLLOW, 0o600)


async def serve(path, group):
    leases = Leases(inventory(), LeaseStore(path.with_name(path.name + ".leases")))
    gid = grp.getgrnam(group).gr_gid if group else None
    # A killed daemon leaves a socket inode behind. The lock serializes recovery.
    if path.is_socket() and path.lstat().st_uid == os.geteuid():
        with socket.socket(socket.AF_UNIX) as probe_socket:
            probe_socket.settimeout(1)
            if probe_socket.connect_ex(str(path)) != errno.ECONNREFUSED:
                raise ValueError("socket already in use or its owner cannot be determined")
        path.unlink()
    with socket.socket(socket.AF_UNIX) as listener:
        old_mask = os.umask(0o177)
        try:
            listener.bind(str(path))
        finally:
            os.umask(old_mask)
        try:
            if gid is not None:
                os.chown(path, -1, gid)
                path.chmod(0o660)
            server = await asyncio.start_unix_server(leases.handle, sock=listener, limit=LIMIT)
            stop = asyncio.Event()
            for sig in (signal.SIGINT, signal.SIGTERM):
                asyncio.get_running_loop().add_signal_handler(sig, stop.set)
            async with server:
                print(f"listening on {path} for NPU IDs {leases.devices}", flush=True)
                scheduler = asyncio.create_task(leases.schedule())
                stopping = asyncio.create_task(stop.wait())
                try:
                    await asyncio.wait({scheduler, stopping}, return_when=asyncio.FIRST_COMPLETED)
                    if scheduler.done():
                        scheduler.result()
                finally:
                    for task in (scheduler, stopping):
                        task.cancel()
                    await asyncio.gather(scheduler, stopping, return_exceptions=True)
        finally:
            path.unlink(missing_ok=True)


def request_server(args):
    with socket.socket(socket.AF_UNIX) as conn:
        conn.connect(args.socket)
        request = {"op": args.action}
        if args.action == "run":
            request.update(ids=args.ids, num=args.num, wait=args.wait)
        conn.sendall(json.dumps(request).encode() + b"\n")
        with conn.makefile("rb") as stream:
            return handle_response(args, conn, stream)


def handle_response(args, conn, stream):
    response = json.loads(stream.readline(65536))
    if "error" in response:
        print(f"npu-lease: {response['error']}", file=sys.stderr)
        return 1
    if args.action == "status":
        print(json.dumps(response["devices"], indent=2))
        return 0
    env = dict(os.environ, ASCEND_RT_VISIBLE_DEVICES=",".join(map(str, sorted(response["ids"]))))
    return run_workload(args.command, env, conn, stream)


GATED_EXEC = """
import os
import sys
fd = int(sys.argv[1])
permit = os.read(fd, 1)
os.close(fd)
if permit != b"1":
    sys.exit(1)
try:
    os.execvpe(sys.argv[2], sys.argv[2:], os.environ)
except OSError as exc:
    print(f"npu-lease: {exc}", file=sys.stderr)
    sys.exit(127)
"""


def run_workload(command, env, conn, stream):
    child = None
    queued_signals = []

    def forward(signum, _frame):
        if child is None:
            queued_signals.append(signum)
        elif child.returncode is None:
            child.send_signal(signum)

    signals = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    previous = {signum: signal.signal(signum, forward) for signum in signals}
    try:
        gate_read, gate_write = os.pipe()
        try:
            child = subprocess.Popen(
                [sys.executable, "-c", GATED_EXEC, str(gate_read), *command],
                env=env, pass_fds=(gate_read,),
            )
        finally:
            os.close(gate_read)
            if child is None:
                os.close(gate_write)
        try:
            for signum in queued_signals:
                child.send_signal(signum)
            conn.sendall(json.dumps({"pid": child.pid}).encode() + b"\n")
            registration = json.loads(stream.readline(65536))
            if registration.get("bound") is not True:
                raise ValueError(registration.get("error", "lease registration failed"))
            os.write(gate_write, b"1")
        finally:
            os.close(gate_write)
            child.wait()
        return child.returncode
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--socket", default=os.getenv("NPU_LEASE_SOCKET", DEFAULT_SOCKET))
    commands = parser.add_subparsers(dest="action", required=True)
    start = commands.add_parser("daemon", aliases=["deamon"])
    start.add_argument("socket_path", nargs="?")
    start.add_argument("--group", help="allow this Unix group to connect")
    status = commands.add_parser("status")
    run = commands.add_parser("run")
    selection = run.add_mutually_exclusive_group(required=True)
    selection.add_argument("--ids", type=lambda raw: [int(device) for device in raw.split(",")])
    selection.add_argument("--num", "--count", type=int)
    run.add_argument("--wait", action="store_true")
    run.add_argument("command", nargs=argparse.REMAINDER)
    for subcommand in (start, status, run):
        subcommand.add_argument("--socket", default=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.action == "deamon":
        args.action = "daemon"
    if args.action == "daemon" and args.socket_path is not None:
        args.socket = args.socket_path
    if args.action == "run":
        if len(args.command) < 2 or args.command[0] != "--":
            run.error("expected -- followed by a command")
        args.command = args.command[1:]
    try:
        if args.action == "daemon":
            asyncio.run(daemon(Path(args.socket), args.group))
            return 0
        status = request_server(args)
        if status < 0:
            signum = -status
            if signum not in (signal.SIGKILL, signal.SIGSTOP):
                signal.signal(signum, signal.SIG_DFL)
            os.kill(os.getpid(), signum)
            return 128 + signum
        return status
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        print(f"npu-lease: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
